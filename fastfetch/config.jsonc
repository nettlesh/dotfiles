{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " -> "
    },
    // Every key is exactly 14 cells wide so the box borders line up
    // Names are padded by hand: keys accept neither the format padding
    // operators nor a right-aligning keyWidth
    "modules": [
        {
            "type": "custom",
            "format": "{#bold_yellow}╭────────────╮{#}"
        },
        {
            "type": "title",
            "key": "│     user  │",
            "keyColor": "yellow"
        },
        {
            "type": "os",
            "key": "│       os {icon} │",
            "keyColor": "yellow",
            "format": "{name} {codename} {version}"
        },
        {
            "type": "kernel",
            "key": "│   kernel  │",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ packages 󰏖 │",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "│   uptime  │",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "{#bold_red}├────────────┤{#}"
        },
        {
            "type": "wm",
            "key": "│       wm  │",
            "keyColor": "red",
            "format": "{pretty-name}"
        },
        {
            "type": "theme",
            "key": "│    theme 󰉼 │",
            "keyColor": "red"
        },
        {
            "type": "terminal",
            "key": "│ terminal  │",
            "keyColor": "red",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "│    shell  │",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "{#bold_blue}├────────────┤{#}"
        },
        {
            "type": "host",
            "key": "│     host 󰌢 │",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "│      cpu  │",
            "keyColor": "blue",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "│      gpu 󰾲 │",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "│   memory  │",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "│     disk  │",
            "keyColor": "blue",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
        },
        {
            "type": "custom",
            "format": "{#bold_blue}╰────────────╯{#}"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 18
        }
    ]
}
