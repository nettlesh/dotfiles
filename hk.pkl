amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

// Preserve generated herdr scripts without formatter changes
local herdrHooks = "**/herdr-agent-state.sh"

local linters = new Mapping {
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    exclude = herdrHooks
  }
  // fish -n treats additional paths as arguments, so validate each file separately
  ["fish"] = new Step {
    glob = "**/*.fish"
    check = "failed=0; for f in {{ files }}; do fish -n \"$f\" || failed=1; done; exit $failed"
  }
  ["fish-format"] = new Step {
    glob = "**/*.fish"
    check = "fish_indent -c {{ files }}"
    fix = "fish_indent -w {{ files }}"
  }
  ["hk-test"] = Builtins.hk_test
  // mise and tombi intentionally enforce identical formatting
  ["mise"] = Builtins.mise
  ["newlines"] = Builtins.newlines
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["rumdl"] = Builtins.rumdl
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = (Builtins.shfmt) {
    exclude = herdrHooks
  }
  ["stylua"] = Builtins.stylua
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
}

hooks {
  ["check"] {
    steps = linters
  }
  ["fix"] {
    steps = linters
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
}
