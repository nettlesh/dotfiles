amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

// Preserve generated herdr scripts without formatter changes
local herdrHooks = "**/herdr-agent-state.sh"

steps {
  ["actionlint"] = Builtins.actionlint
  ["betterleaks"] = Builtins.betterleaks
  ["editorconfig-checker"] = (Builtins.editorconfig_checker) {
    exclude = herdrHooks
  }
  // fish -n treats additional paths as arguments, so validate each file separately
  ["fish"] = new Step {
    glob = "**/*.fish"
    check = new CommandSpec {
      command = "failed=0; for f in {{ files }}; do fish -n \"$f\" || failed=1; done; exit $failed"
      effect = "read"
    }
  }
  ["fish-format"] = new Step {
    glob = "**/*.fish"
    check = new CommandSpec {
      command = new Command { argv = List("fish_indent", "-c", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("fish_indent", "-w", "{{files}}") }
      effect = "write"
    }
  }
  ["hadolint"] = Builtins.hadolint
  ["hk-test"] = Builtins.hk_test
  // mise and tombi intentionally enforce identical formatting
  ["mise"] = Builtins.mise
  ["newlines"] = Builtins.newlines
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["rumdl"] = Builtins.rumdl
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = (Builtins.shfmt) {
    exclude = herdrHooks
  }
  ["stylua"] = Builtins.stylua
  ["tombi"] = Builtins.tombi
  ["tombi-format"] = Builtins.tombi_format
  ["zizmor"] = Builtins.zizmor
}
