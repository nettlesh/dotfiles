[include]
    path = ~/.config/git/identity
    path = ~/.config/git/1password

[core]
    editor = nvim
    pager  = delta

[delta]
    navigate = true

[interactive]
    diffFilter = delta --color-only

[diff]
    colorMoved = default

[merge]
    conflictstyle = zdiff3

# Resolve hk through mise instead of a versioned executable path
# TODO: Revisit these four events if hk changes its global install set
[hook "hk-commit-msg"]
    command = test \"${HK:-1}\" = \"0\" || mise x hk -- hk run commit-msg --from-hook
    event   = commit-msg

[hook "hk-pre-commit"]
    command = test \"${HK:-1}\" = \"0\" || mise x hk -- hk run pre-commit --from-hook --staged
    event   = pre-commit

[hook "hk-pre-push"]
    command = test \"${HK:-1}\" = \"0\" || mise x hk -- hk run pre-push --from-hook
    event   = pre-push

[hook "hk-prepare-commit-msg"]
    command = test \"${HK:-1}\" = \"0\" || mise x hk -- hk run prepare-commit-msg --from-hook
    event   = prepare-commit-msg

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true

[alias]
    a    = add
    aa   = add --all
    au   = add --update
    b    = branch
    bd   = branch --delete
    c    = commit -m
    ca   = commit --amend
    d    = diff
    ds   = diff --staged
    f    = fetch --prune
    fa   = fetch --all --prune
    l    = log --oneline
    lg   = log --graph --oneline --all
    m    = merge
    p    = push
    pl   = pull
    r    = rebase
    rc   = rebase --continue
    ri   = rebase --interactive
    root = rev-parse --show-toplevel
    rs   = restore
    rss  = restore --staged
    s    = status -sb
    st   = stash
    stp  = stash pop
    sw   = switch
    swc  = switch --create
    t    = tag
    td   = tag --delete
