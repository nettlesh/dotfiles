{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "npm": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "minimumReleaseAge": "24 hours"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    }
  ]
}
